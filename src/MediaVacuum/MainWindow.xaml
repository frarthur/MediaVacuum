<Window x:Class="MediaVacuum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MediaVacuum.ViewModels"
        xmlns:conv="clr-namespace:MediaVacuum.Converters"
        mc:Ignorable="d"
        Drop="OnUrlDrop"
        AllowDrop="True"
        Title="{Binding T.AppTitle}"
        Height="650" Width="780"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="48" Height="48"
                    CornerRadius="8"
                    Background="{StaticResource PrimaryBrush}"
                    Margin="0,0,12,0">
                <TextBlock Text="MV"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding T.AppTitle}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding T.AppSubtitle}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{Binding T.YtDlpVersion}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text=" : " FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding YtDlpVersion}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- URL Input -->
                <GroupBox Header="{Binding T.UrlLabel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 AllowDrop="True"
                                 ToolTip="{Binding T.UrlTooltip}" />

                        <Button Grid.Column="1"
                                Content="{Binding T.Download}"
                                Command="{Binding StartDownloadCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"
                                Width="140" />
                    </Grid>
                </GroupBox>

                <!-- Options -->
                <GroupBox Header="{Binding T.Options}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding T.OutputFolder}" Style="{StaticResource Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" />
                                <Button Grid.Column="1" Content="{Binding T.Browse}"
                                        Command="{Binding BrowseOutputCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="4,0,0,0"
                                        Width="36" Padding="4" />
                            </Grid>

                            <TextBlock Text="{Binding T.VideoFormat}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                            <ComboBox SelectedItem="{Binding SelectedFormat}"
                                      ItemsSource="{Binding FormatPresets}"
                                      IsEditable="True" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <CheckBox Content="{Binding T.ExtractAudio}" IsChecked="{Binding ExtractAudio}" />
                            <ComboBox SelectedItem="{Binding SelectedAudioFormat}"
                                      ItemsSource="{Binding AudioFormats}"
                                      IsEnabled="{Binding ExtractAudio}"
                                      Margin="24,4,0,8" />

                            <CheckBox Content="{Binding T.EmbedMetadata}" IsChecked="{Binding EmbedMetadata}" />
                            <CheckBox Content="{Binding T.EmbedThumbnail}" IsChecked="{Binding EmbedThumbnail}" Margin="0,4,0,0" />
                            <CheckBox Content="{Binding T.DownloadSubtitles}" IsChecked="{Binding WriteSubtitles}" Margin="0,4,0,0" />

                            <!-- Language selector -->
                            <TextBlock Text="{Binding T.Language}" Style="{StaticResource Label}" Margin="0,12,0,0" />
                            <ComboBox SelectedItem="{Binding SelectedLanguage}"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      Margin="0,0,0,4" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Progress -->
                <GroupBox Header="{Binding T.Progress}" Visibility="{Binding IsDownloading, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <StackPanel>
                        <ProgressBar Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Maximum="100" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Status}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="8,0" CornerRadius="4"
                Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Status}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding T.CheckUpdate}"
                            Command="{Binding CheckUpdateCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0"
                            Height="28" Padding="8,4"
                            FontSize="11" />

                    <Button Content="{Binding T.InstallMenu}"
                            Command="{Binding InstallContextMenuCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0"
                            Height="28" Padding="8,4"
                            FontSize="11" />

                    <Button Content="{Binding T.RemoveMenu}"
                            Command="{Binding UninstallContextMenuCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="4,0"
                            Height="28" Padding="8,4"
                            FontSize="11" />

                    <Button Content="{Binding T.Uninstall}"
                            Command="{Binding UninstallAppCommand}"
                            Style="{StaticResource DangerButton}"
                            Margin="4,0,0,0"
                            Height="28" Padding="8,4"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
